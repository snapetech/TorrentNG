# rtorrentNG engine profile
# Pinned for rTorrent 0.16.11, tinyxml2 XMLRPC backend

# Network
network.port_range.set = 50000-50000
network.port_random.set = no

protocol.encryption.set = allow_incoming,try_outgoing,enable_retry

# DHT / PEX / LSD
dht.mode.set = on
# Container/systemd launchers pin dht.port and dht.override_port to the public
# incoming port so the UDP socket that Docker/firewalls expose is the one DHT uses.
protocol.pex.set = yes
trackers.use_udp.set = yes

# Performance tuning for large seed libraries
# Home/test builds bias toward more concurrent activity; override in
# /config/rtorrent.rc for tighter production envelopes.
throttle.max_uploads.global.set = 350
throttle.max_downloads.global.set = 300

# Per-torrent slot limits
throttle.max_uploads.set = 10
throttle.max_downloads.set = 12

# Piece/chunk settings
pieces.hash.on_completion.set = yes
pieces.memory.max.set = 4096M

# File/socket and tracker concurrency
network.max_open_files.set = 4096
network.max_open_sockets.set = 2048
network.http.max_open.set = 512
network.http.max_total_connections.set = 256
network.http.max_host_connections.set = 64
network.http.max_cache_connections.set = 512

# Session
session.use_lock.set = yes
session.on_completion.set = yes

# SCGI socket — sidecar connects via trusted local socket
# scgi_local path is set by the entrypoint/systemd to /run/rtorrent/rpc.sock
# Do NOT expose SCGI over TCP to untrusted networks.

# Announce throttling — avoid hammering trackers on restart
trackers.numwant.set = 200

# Logging
log.open_file = "rtorrent", /var/log/rtorrent/rtorrent.log
log.add_output = "info", "rtorrent"

# File completion handling
# Set directory via d.directory.set in load commands; no default download dir
# (each torrent must have save_path set explicitly by the sidecar)
