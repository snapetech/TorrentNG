[Unit]
Description=TorrentNG native BitTorrent client and WebUI/API
Documentation=https://github.com/snapetech/TorrentNG
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torrentngd
Group=torrentngd
Environment=TORRENTNGD_CONFIG=/etc/torrentngd/config.toml
Environment=TNG_STATIC_DIR=/usr/share/torrentng/webui
Environment=RUST_LOG=info
ExecStart=/usr/bin/torrentngd
Restart=on-failure
RestartSec=5s
StateDirectory=torrentngd
StateDirectoryMode=0750
ConfigurationDirectory=torrentngd
ConfigurationDirectoryMode=0750
ReadWritePaths=/var/lib/torrentngd
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
