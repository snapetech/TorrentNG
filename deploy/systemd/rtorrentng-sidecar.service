[Unit]
Description=rtorrentNG Sidecar API Daemon
After=rtorrent.service
Requires=rtorrent.service

[Service]
Type=simple
User=rtorrent
Group=rtorrent
Environment=RTNG_STATIC_DIR=/usr/share/rtorrentng/webui
ExecStart=/usr/local/bin/rtorrentng /etc/rtorrentng/config.toml
Restart=on-failure
RestartSec=5

# State directory for SQLite cache
StateDirectory=rtorrentng
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
