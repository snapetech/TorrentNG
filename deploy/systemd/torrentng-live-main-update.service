[Unit]
Description=Update TorrentNG home live-main Docker build
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/code/TorrentNG
Environment=TNG_LIVE_BRANCH=main
Environment=TNG_LIVE_COMPOSE_FILE=deploy/certification/compose.yml
Environment=TNG_LIVE_COMPOSE_ENV_FILE=deploy/certification/.env
Environment=TNG_HOST_PORT=28081
Environment=TNG_INCOMING_PORT=51001
Environment=DOCKER_BUILDKIT=0
ExecStart=%h/Documents/code/TorrentNG/scripts/home_live_update.sh
