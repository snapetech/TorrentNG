[Unit]
Description=rtorrentNG VPN forwarded-port watcher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/keith/Documents/code/rtorrentNG
EnvironmentFile=-/etc/rtorrentng/vpn-forward-watch.env
ExecStart=/home/keith/Documents/code/rtorrentNG/scripts/vpn/rtng_vpn_forward_watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
