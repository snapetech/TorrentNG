[Unit]
Description=TorrentNG Sidecar API Daemon
After=rtorrent.service
Requires=rtorrent.service

[Service]
Type=simple
User=rtorrent
Group=rtorrent
Environment=TNG_STATIC_DIR=/usr/share/torrentng/webui
ExecStart=/usr/local/bin/torrentng /etc/torrentng/config.toml
Restart=on-failure
RestartSec=5

# State directory for SQLite cache
StateDirectory=torrentng
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
