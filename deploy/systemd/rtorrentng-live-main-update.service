[Unit]
Description=Update rtorrentNG home live-main Docker build
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/code/rtorrentNG
Environment=RTNG_LIVE_BRANCH=main
Environment=RTNG_LIVE_COMPOSE_FILE=deploy/certification/compose.yml
Environment=RTNG_LIVE_COMPOSE_ENV_FILE=deploy/certification/.env
Environment=RTNG_HOST_PORT=28081
Environment=RTNG_INCOMING_PORT=51001
ExecStart=%h/Documents/code/rtorrentNG/scripts/home_live_update.sh
