    },
    "/api/v1/torrents/{hash}": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
      "get": {"operationId": "getTorrent", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "put": {"operationId": "updateTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "delete": {"operationId": "deleteTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "202": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}}
    },
    "/api/v1/torrents/{hash}/start": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "startTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/resume": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "resumeTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/stop": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "stopTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/pause": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "pauseTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/recheck": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "recheckTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/reannounce": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "reannounceTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/category": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "put": {"operationId": "setTorrentCategory", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
