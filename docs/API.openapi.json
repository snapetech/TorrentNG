{
  "openapi": "3.1.0",
  "info": {
    "title": "TorrentNG API",
    "version": "0.1.0",
    "description": "Machine-readable contract for the implemented TorrentNG /api/v1 JSON REST surface. Compatibility facades are documented by their client-specific matrices. Mutating requests accept an optional Idempotency-Key; successful responses may be replayed with Idempotency-Replayed: true. API tokens are bearer tokens or tng_session cookies."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}, {"sessionCookie": []}],
  "paths": {
    "/health": {
      "get": {"operationId": "health", "security": [], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "503": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/metrics": {
      "get": {"operationId": "metrics", "responses": {"200": {"description": "Prometheus text exposition", "content": {"text/plain": {"schema": {"type": "string"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/auth/login": {
      "post": {"operationId": "authLogin", "security": [], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/auth/logout": {
      "post": {"operationId": "authLogout", "security": [], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}
    },
    "/api/v1/torrents": {
      "get": {"operationId": "listTorrents", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Snapshot"}, {"$ref": "#/components/parameters/Filter"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "post": {"operationId": "addTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/AddTorrent"}, "responses": {"201": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}}
    },
    "/api/v1/torrents/live": {
      "get": {"operationId": "liveTorrentStats", "parameters": [{"name": "hashes", "in": "query", "required": true, "description": "Comma-separated list of at most 128 non-empty 40/64-character hexadecimal info hashes; repeated entries count toward the limit and the value is capped at 8,320 bytes", "schema": {"type": "string", "maxLength": 8320}}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/api/v1/torrents/{hash}": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
      "get": {"operationId": "getTorrent", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "put": {"operationId": "updateTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "202": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "delete": {"operationId": "deleteTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "202": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}}
    },
    "/api/v1/torrents/{hash}/start": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "startTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/resume": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "resumeTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/stop": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "stopTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/pause": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "pauseTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/recheck": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "recheckTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/reannounce": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "reannounceTorrent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/category": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "put": {"operationId": "setTorrentCategory", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/SetTorrentCategory"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/torrents/{hash}/limits": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
      "get": {"operationId": "getTorrentLimits", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "put": {"operationId": "updateTorrentLimits", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "501": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/api/v1/torrents/{hash}/peers": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "addTorrentPeers", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/torrents/queue": {"post": {"operationId": "updateTorrentQueue", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/torrents/{hash}/tags": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
      "post": {"operationId": "addTorrentTags", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/TorrentTags"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}},
      "patch": {"operationId": "patchTorrentTags", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/PatchTorrentTags"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}},
      "delete": {"operationId": "removeTorrentTags", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/TorrentTags"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "404": {"$ref": "#/components/responses/NotFound"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}}
    },
    "/api/v1/torrents/{hash}/files": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
      "get": {"operationId": "listTorrentFiles", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "patch": {"operationId": "patchTorrentFiles", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/api/v1/torrents/{hash}/trackers": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
      "get": {"operationId": "listTorrentTrackers", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "patch": {"operationId": "patchTorrentTrackers", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/api/v1/torrents/{hash}/diagnostics": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "get": {"operationId": "diagnoseTorrent", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/transfer/info": {"get": {"operationId": "transferInfo", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/transfer/limits": {
      "get": {"operationId": "transferLimits", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "put": {"operationId": "updateTransferLimits", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}
    },
    "/api/v1/session/features": {
      "get": {"operationId": "sessionFeatures", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "put": {"operationId": "updateSessionFeatures", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}
    },
    "/api/v1/categories": {
      "get": {"operationId": "listCategories", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "post": {"operationId": "upsertCategory", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/CategoryUpsert"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}}
    },
    "/api/v1/categories/{name}": {"parameters": [{"$ref": "#/components/parameters/Name"}], "delete": {"operationId": "deleteCategory", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/tags": {
      "get": {"operationId": "listTags", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "post": {"operationId": "createTag", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/TagCreate"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}}
    },
    "/api/v1/tags/{name}": {"parameters": [{"$ref": "#/components/parameters/Name"}], "delete": {"operationId": "deleteTag", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/bulk/{action}": {"parameters": [{"$ref": "#/components/parameters/Action"}], "post": {"operationId": "bulkAction", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/BulkAction"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "422": {"$ref": "#/components/responses/InvalidRequest"}}}},
    "/api/v1/cross-seed": {"post": {"operationId": "crossSeed", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/tracker-health": {"get": {"operationId": "trackerHealth", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/sidebar-facets": {"get": {"operationId": "sidebarFacets", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/logs": {"get": {"operationId": "logs", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/LastKnownId"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/saved-views": {"get": {"operationId": "listSavedViews", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertSavedView", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/saved-views/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "delete": {"operationId": "deleteSavedView", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/ratio-groups": {"get": {"operationId": "listRatioGroups", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertRatioGroup", "description": "The TorrentNG daemon stores at most 4,096 entries and 1 MiB of serialized JSON. Native IDs, names, and category filters are limited to 256 UTF-8 bytes; tracker filters to 8,192 bytes. Invalid shapes or oversized fields return 400, count capacity returns 429, and aggregate overflow returns 413 without replacing stored state.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"description": "Invalid ratio group fields."}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "429": {"description": "Ratio group capacity reached."}}}},
    "/api/v1/ratio-groups/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "runRatioGroup", "description": "Applies to at most 10,000 matching torrents; larger matches return 413 before mutation. Over-limit stored native rules fail closed with 400. The native daemon response contains at most 32 samples per result array with full totals and errors truncated to 512 UTF-8 bytes. Returns 501 when the selected backend does not support share limits.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/NativeWorkflowResult"}, "400": {"description": "Invalid or oversized stored ratio group."}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "501": {"description": "Selected backend does not support share limits."}, "503": {"$ref": "#/components/responses/JsonError"}}}, "delete": {"operationId": "deleteRatioGroup", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/workflows": {"get": {"operationId": "listWorkflows", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertWorkflow", "description": "The category field filters matching torrents; target_category is the destination for set_category actions. Category-only legacy rules migrate their category to target_category, and set_category requires a non-empty destination. Native IDs, names, and category fields are limited to 256 UTF-8 bytes; event/action to 64; tracker/filter/command/URL text to 8,192; and paths to 4,096. The daemon stores at most 4,096 entries and 1 MiB serialized. Invalid shapes or oversized fields return 400, count capacity returns 429, and aggregate overflow returns 413 without replacing stored state.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"description": "Invalid workflow fields or an unsupported legacy rule."}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "429": {"description": "Workflow rule capacity reached."}}}},
    "/api/v1/workflows/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "runWorkflow", "description": "Runs a rule over at most 10,000 matching torrents; larger matches return 413 before actions. The native response contains at most 32 samples per result array with full totals and errors truncated to 512 UTF-8 bytes. Invalid oversized or incomplete legacy rules fail closed with 400.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/NativeWorkflowResult"}, "400": {"description": "Invalid or oversized stored workflow rule."}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "503": {"$ref": "#/components/responses/JsonError"}}}, "delete": {"operationId": "deleteWorkflow", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/workflow-runs": {"get": {"operationId": "listWorkflowRuns", "description": "Native history retains at most 200 records and 1 MiB serialized, evicting oldest records as needed. Each result array has at most 32 samples, full totals, and errors capped at 512 UTF-8 bytes.", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/rss-rules": {"get": {"operationId": "listRssRules", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertRssRule", "description": "Native RSS rules limit IDs, names, and categories to 256 UTF-8 bytes; rule text/feed URLs to 8,192; save paths to 4,096; and tags to at most 1,024 values of 256 bytes each. The daemon stores at most 4,096 entries and 1 MiB serialized. Invalid shapes or oversized fields return 400, count capacity returns 429, and aggregate overflow returns 413 without replacing stored state.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"description": "Invalid RSS rule fields."}, "413": {"$ref": "#/components/responses/PayloadTooLarge"}, "429": {"description": "RSS rule capacity reached."}}}},
    "/api/v1/rss-rules/test": {"post": {"operationId": "testRssRules", "description": "Title and optional link are each limited to 8,192 UTF-8 bytes during JSON deserialization. Empty titles return 400; invalid oversized legacy rules fail closed with 503.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"description": "Title must not be empty."}, "422": {"$ref": "#/components/responses/InvalidRequest"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/rss-rules/apply": {"post": {"operationId": "applyRssRules", "description": "Title and optional link are each limited to 8,192 UTF-8 bytes during JSON deserialization. Empty titles return 400. No matching rules complete as a no-op without requiring a link or live client. The native response has at most 32 matched rule-name, applied, and error samples with full totals and 512-byte error samples; non-dry runs are recorded in workflow history. Invalid oversized legacy rules fail closed with 503.", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/NativeWorkflowResult"}, "400": {"description": "Title must not be empty."}, "422": {"$ref": "#/components/responses/InvalidRequest"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/rss-rules/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "delete": {"operationId": "deleteRssRule", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/engine": {"get": {"operationId": "engineDiagnostics", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/engine/commands": {"get": {"operationId": "engineCommands", "responses": {"501": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/engine/rtorrent-settings": {"get": {"operationId": "getRtorrentSettings", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "put": {"operationId": "saveRtorrentSettings", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "501": {"$ref": "#/components/responses/JsonError"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/engine/restart": {"post": {"operationId": "restartEngine", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"501": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/engine/user-agent": {"get": {"operationId": "getEngineUserAgent", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "put": {"operationId": "setEngineUserAgent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/settings/user-agent": {"get": {"operationId": "getUserAgent", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "put": {"operationId": "setUserAgent", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/events": {"get": {"operationId": "streamEvents", "parameters": [{"$ref": "#/components/parameters/LastKnownRevision"}], "responses": {"200": {"description": "Bounded server-sent event stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}}}}},
    "/api/v1/session-events": {"get": {"operationId": "listSessionEvents", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/LastKnownId"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/jobs": {"get": {"operationId": "listJobs", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/jobs/{id}/pause": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "pauseJob", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/jobs/{id}/resume": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "resumeJob", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/jobs/{id}/cancel": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "cancelJob", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/storage": {"get": {"operationId": "storage", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/storage/plan": {"post": {"operationId": "previewStoragePlan", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/storage/execute": {"post": {"operationId": "executeStoragePlan", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"202": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "409": {"$ref": "#/components/responses/JsonError"}}}}
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"},
      "sessionCookie": {"type": "apiKey", "in": "cookie", "name": "tng_session"}
