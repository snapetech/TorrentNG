{
  "openapi": "3.1.0",
  "info": {
    "title": "TorrentNG Native API",
    "version": "0.1.0",
    "description": "Machine-readable contract for the implemented native /api/v1 JSON REST surface. Compatibility facades are documented by their client-specific matrices. Mutating requests accept an optional Idempotency-Key; successful responses may be replayed with Idempotency-Replayed: true. API tokens are bearer tokens or tng_session cookies."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}, {"sessionCookie": []}],
  "paths": {
    "/health": {
      "get": {"operationId": "health", "security": [], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "503": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/metrics": {
      "get": {"operationId": "metrics", "responses": {"200": {"description": "Prometheus text exposition", "content": {"text/plain": {"schema": {"type": "string"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/auth/login": {
