    "/api/v1/storage/plan": {"post": {"operationId": "previewStoragePlan", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/storage/execute": {"post": {"operationId": "executeStoragePlan", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"202": {"$ref": "#/components/responses/JsonOk"}, "400": {"$ref": "#/components/responses/JsonError"}, "409": {"$ref": "#/components/responses/JsonError"}}}}
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"},
      "sessionCookie": {"type": "apiKey", "in": "cookie", "name": "tng_session"}
    },
    "parameters": {
      "Hash": {"name": "hash", "in": "path", "required": true, "schema": {"type": "string", "minLength": 40, "maxLength": 64}},
      "Name": {"name": "name", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "Action": {"name": "action", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "Limit": {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 5000}},
      "Offset": {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}},
      "Snapshot": {"name": "snapshot", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}},
      "Filter": {"name": "filter", "in": "query", "required": false, "schema": {"type": "string"}},
      "LastKnownId": {"name": "last_known_id", "in": "query", "required": false, "schema": {"type": "integer"}},
      "LastKnownRevision": {"name": "last_known_revision", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": false, "description": "Printable ASCII key, max 128 bytes. Successful responses are replayable for the retention window; reuse with a different request is rejected.", "schema": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "requestBodies": {
      "JsonObject": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
      "AddTorrent": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddTorrentRequest"}}}}
    },
    "responses": {
      "JsonOk": {"description": "JSON response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonValue"}}}},
      "JsonError": {"description": "Structured API error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Missing or invalid API token"},
      "NotFound": {"description": "Torrent, job, or named resource was not found"},
      "PayloadTooLarge": {"description": "Request exceeds the facade body limit"},
      "Empty": {"description": "Mutation accepted with no response body"}
    },
    "schemas": {
      "JsonValue": {},
      "JsonObject": {"type": "object", "additionalProperties": true},
      "AddTorrentRequest": {"type": "object", "required": ["save_path"], "properties": {"torrent_b64": {"type": ["string", "null"]}, "magnet": {"type": ["string", "null"]}, "save_path": {"type": "string", "minLength": 1}, "category": {"type": ["string", "null"]}, "tags": {"type": ["array", "null"], "items": {"type": "string"}}, "start": {"type": ["boolean", "null"]}}, "additionalProperties": false},
      "Error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "required": ["code", "message"], "additionalProperties": true}
    }
  }
}
