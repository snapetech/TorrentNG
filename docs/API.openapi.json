    "/api/v1/saved-views/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "delete": {"operationId": "deleteSavedView", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/ratio-groups": {"get": {"operationId": "listRatioGroups", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertRatioGroup", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/ratio-groups/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "runRatioGroup", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "delete": {"operationId": "deleteRatioGroup", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/workflows": {"get": {"operationId": "listWorkflows", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertWorkflow", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/workflows/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "runWorkflow", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "delete": {"operationId": "deleteWorkflow", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/workflow-runs": {"get": {"operationId": "listWorkflowRuns", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/rss-rules": {"get": {"operationId": "listRssRules", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}, "post": {"operationId": "upsertRssRule", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/rss-rules/test": {"post": {"operationId": "testRssRules", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/rss-rules/apply": {"post": {"operationId": "applyRssRules", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/rss-rules/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "delete": {"operationId": "deleteRssRule", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
