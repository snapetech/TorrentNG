      "get": {"operationId": "listTorrentTrackers", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "patch": {"operationId": "patchTorrentTrackers", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/api/v1/torrents/{hash}/diagnostics": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "get": {"operationId": "diagnoseTorrent", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
    "/api/v1/transfer/info": {"get": {"operationId": "transferInfo", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}, "503": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/transfer/limits": {
      "get": {"operationId": "transferLimits", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "put": {"operationId": "updateTransferLimits", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}
    },
    "/api/v1/session/features": {
      "get": {"operationId": "sessionFeatures", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "put": {"operationId": "updateSessionFeatures", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}
    },
    "/api/v1/categories": {
      "get": {"operationId": "listCategories", "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}},
      "post": {"operationId": "upsertCategory", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}
    },
