    "/api/v1/cross-seed": {"post": {"operationId": "crossSeed", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonOk"}}}},
