      "put": {"operationId": "updateTorrentLimits", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "501": {"$ref": "#/components/responses/JsonError"}}}
    },
    "/api/v1/torrents/{hash}/peers": {"parameters": [{"$ref": "#/components/parameters/Hash"}], "post": {"operationId": "addTorrentPeers", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}, "400": {"$ref": "#/components/responses/JsonError"}}}},
    "/api/v1/torrents/queue": {"post": {"operationId": "updateTorrentQueue", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"204": {"$ref": "#/components/responses/Empty"}}}},
    "/api/v1/torrents/{hash}/tags": {
      "parameters": [{"$ref": "#/components/parameters/Hash"}],
